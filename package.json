{
  "name": "music-sheet-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "npm run vendor",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "debug:pipeline": "tsx scripts/debug-pipeline.ts",
    "debug:export": "tsx scripts/export-sample.ts",
    "debug:image": "tsx scripts/debug-image.ts",
    "bench": "tsx scripts/bench.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.64.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
